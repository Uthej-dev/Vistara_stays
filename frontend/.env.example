# Copy to `.env.local` if you need to override. Vite only exposes variables prefixed VITE_,
# and everything here ends up in the public JavaScript bundle — never put secrets in it.

# API base path. Keep the default (/api/v1): requests go through the Vite proxy in development
# and the Vercel rewrite in production.
VITE_API_BASE_URL=/api/v1
