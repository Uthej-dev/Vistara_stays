# Copy this file to `.env` and fill in real values. `.env` is git-ignored — never commit it.
# Every setting is read by app/core/config.py, which refuses to start with unsafe production values.

# ---------- core ----------
# development | test | production
APP_ENV=development

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers → Python).
# If the password contains special characters such as @ : / ? # [ ] %, URL-encode them.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=vistara
MONGODB_DB=vistara_dev

# Secret used to sign access tokens (32+ characters in production). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me

# Browser origins allowed to call the API (comma-separated). In production: your Vercel URL.
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend (used in email links).
FRONTEND_URL=http://localhost:5173
# Public URL of this API (used for links to locally stored images in development).
PUBLIC_API_URL=http://localhost:8000

ENSURE_INDEXES_ON_STARTUP=true
# Interactive API docs at /api/docs.
ENABLE_DOCS=true
LOG_LEVEL=INFO

# ---------- auth ----------
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
# Must be true in production (cookies only over HTTPS).
COOKIE_SECURE=false
# Customers must verify their email before booking.
REQUIRE_EMAIL_VERIFICATION=false
RATE_LIMIT_ENABLED=true

# ---------- email ----------
# console = print emails (with links) to the server log; resend = send via https://resend.com
EMAIL_BACKEND=console
EMAIL_FROM=Vistara Stays <no-reply@vistarastays.example>
RESEND_API_KEY=

# SMS booking confirmations: console (logs) | twilio. Indian numbers need DLT registration.
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- images ----------
# local = save uploads in backend/media (development only); cloudinary = required in production
IMAGE_STORAGE=local  # local | cloudinary | disabled (production: cloudinary or disabled)
MEDIA_DIR=media
MAX_UPLOAD_MB=5
# From https://console.cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- payments ----------
# simulated = clearly labelled fake payments (development); razorpay = real checkout (test or live keys)
PAYMENT_PROVIDER=simulated
# From https://dashboard.razorpay.com (switch to Test Mode) → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings → Webhooks → Add: URL https://<your-api>/api/v1/payments/razorpay/webhook,
# events payment.captured, payment.failed, refund.processed, refund.failed; set a secret here:
RAZORPAY_WEBHOOK_SECRET=

# ---------- background maintenance ----------
# Seconds between hold-expiry / stay-completion sweeps while the server is awake (0 = off).
MAINTENANCE_INTERVAL_SECONDS=60
