# Copy this file to `.env` and fill in real values. `.env` is git-ignored — never commit it.

# development | test | production
APP_ENV=development

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers → Python).
# Replace <username>/<password> with the database user you created. If the password contains
# special characters such as @ : / ? # [ ], URL-encode them.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=vistara
MONGODB_DB=vistara_dev

# Secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Public URL of the frontend (used in emails, e.g. password-reset links).
FRONTEND_URL=http://localhost:5173

# Create indexes automatically when the server starts (safe to rerun).
ENSURE_INDEXES_ON_STARTUP=true

# Serve interactive API docs at /api/docs (keep false in production unless needed).
ENABLE_DOCS=true

# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
